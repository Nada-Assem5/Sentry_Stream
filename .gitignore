# Dataset (too large for Git)
data/*.csv
data/*.CSV

# Trained models (large binary files)
processing/models/*
!processing/models/.gitkeep

# Pipeline outputs (Parquet, ~1.4GB — regenerated by the Spark jobs.
# Docker recreates the directory from the bind mount, so it needs no .gitkeep.)
processing/output/

# Node dependencies (reinstall with `npm install`)
node_modules/

# Docker volumes / runtime data
docker/volumes/

# Python
__pycache__/
*.pyc
venv/
.env

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/